{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avforge.local/schemas/equipment.schema.json",
  "title": "AVForge Equipment v3.2",
  "description": "Universal structured model for audiovisual equipment.",
  "type": "object",
  "required": ["id", "manufacturer", "model", "product_name", "category", "schema_version", "status"],
  "properties": {
    "id": { "$ref": "#/$defs/stableId" },
    "manufacturer": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "product_name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": "string", "minLength": 1 },
    "product_family": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "part_number": { "type": "string", "minLength": 1 },
    "hardware": { "$ref": "#/$defs/hardware" },
    "power": { "$ref": "#/$defs/power" },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/interface" },
      "uniqueItems": true
    },
    "physical_connectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/physicalConnector" },
      "uniqueItems": true
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "communication_capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/communicationCapability" },
      "uniqueItems": true
    },
    "resource_pools": {
      "type": "array",
      "items": { "$ref": "#/$defs/resourcePool" },
      "uniqueItems": true
    },
    "capability_modifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityModifier" },
      "uniqueItems": true
    },
    "modularity": { "$ref": "#/$defs/modularity" },
    "composition": { "$ref": "#/$defs/compositionMetadata" },
    "infrastructure": { "$ref": "#/$defs/infrastructure" },
    "project_roles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "functional_behavior": { "$ref": "#/$defs/functionalBehavior" },
    "known_compatibilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/compatibility" },
      "uniqueItems": true
    },
    "graphic_representation": { "$ref": "#/$defs/graphicRepresentation" },
    "documentation": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentReference" },
      "uniqueItems": true
    },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "review", "approved", "deprecated"] },
    "internal_knowledge": { "$ref": "#/$defs/internalKnowledge" },
    "extensions": { "type": "object", "additionalProperties": true },
    "custom_fields": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "minLength": 1
    },
    "physicalConnector": {
      "type": "object",
      "required": ["id", "label", "connector_type", "connection_points"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "connector_type": { "type": "string", "minLength": 1 },
        "gender": { "enum": ["male", "female", "receptacle", "none", "not_applicable", "unknown"] },
        "connection_points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/physicalConnectionPoint" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "physicalConnectionPoint": {
      "type": "object",
      "required": ["id", "label", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "role": { "enum": ["signal", "positive", "negative", "ground", "shield", "power", "tx", "rx", "contact", "common", "normally_open", "normally_closed", "other"] },
        "position": { "type": ["integer", "number", "string"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "physicalConnection": {
      "type": "object",
      "required": ["connector_id", "connection_point_ids"],
      "properties": {
        "connector_id": { "$ref": "#/$defs/stableId" },
        "connection_point_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "const": "mm" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "powerMeasurement": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "const": "W" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "voltageRange": {
      "type": "object",
      "required": ["unit"],
      "properties": {
        "value": { "type": "number" },
        "nominal": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "const": "V" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "frequencyRange": {
      "type": "object",
      "required": ["unit"],
      "properties": {
        "value": { "type": "number" },
        "nominal": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "const": "Hz" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/$defs/measurement" },
        "height": { "$ref": "#/$defs/measurement" },
        "depth": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "object",
      "properties": {
        "form_factor": { "type": "string" },
        "rack_mountable": { "type": "boolean" },
        "rack_units": { "type": "number", "minimum": 0 },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "weight": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "const": "kg" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "power": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/powerSource" },
          "uniqueItems": true
        },
        "poe_supplied": {
          "type": "array",
          "items": { "$ref": "#/$defs/poeOutput" },
          "uniqueItems": true
        },
        "heat_dissipation": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "const": "BTU/h" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "powerSource": {
      "type": "object",
      "required": ["id", "method"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "method": { "enum": ["AC", "DC", "PoE", "other"] },
        "connector": { "type": "string", "minLength": 1 },
        "voltage": { "$ref": "#/$defs/voltageRange" },
        "frequency": { "$ref": "#/$defs/frequencyRange" },
        "current": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "const": "A" },
            "note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "power_available": { "$ref": "#/$defs/powerMeasurement" },
        "power_consumption_typical": { "$ref": "#/$defs/powerMeasurement" },
        "power_consumption_max": { "$ref": "#/$defs/powerMeasurement" },
        "poe_consumed": { "$ref": "#/$defs/poeConsumption" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "poeConsumption": {
      "type": "object",
      "properties": {
        "standard": { "type": "string" },
        "class": { "type": "string" },
        "power_typical": { "$ref": "#/$defs/powerMeasurement" },
        "power_max": { "$ref": "#/$defs/powerMeasurement" }
      },
      "additionalProperties": false
    },
    "poeOutput": {
      "type": "object",
      "required": ["id", "interface_id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "interface_id": { "$ref": "#/$defs/stableId" },
        "standard": { "type": "string" },
        "class": { "type": "string" },
        "power_available": { "$ref": "#/$defs/powerMeasurement" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "signalCapability": {
      "type": "object",
      "required": ["id", "name", "signal_type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "signal_type": { "enum": ["audio", "video", "network", "control", "data", "power", "other"] },
        "signal_family": { "type": "string", "minLength": 1 },
        "signal_format": { "type": "string", "minLength": 1 },
        "protocol_family": { "type": "string", "minLength": 1 },
        "proprietary": { "type": "boolean", "default": false },
        "accepted_variants": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "signal_characteristics": { "type": "object", "additionalProperties": true },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "required": ["proprietary"], "properties": { "proprietary": { "const": true } } },
          "then": { "required": ["protocol_family"] }
        }
      ],
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": ["id", "label", "direction", "connector"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "quantity": { "type": "integer", "minimum": 1, "description": "Count of aggregated, otherwise identical elements; never the identity of a physical port." },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "connector": { "type": "string", "minLength": 1 },
        "connector_gender": { "enum": ["male", "female", "receptacle", "none", "not_applicable", "unknown"] },
        "physical_connection": { "$ref": "#/$defs/physicalConnection" },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/signalCapability" },
          "uniqueItems": true
        },
        "electrical_characteristics": { "type": "object", "additionalProperties": true },
        "connection_constraints": { "$ref": "#/$defs/connectionConstraints" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "targetSelector": {
      "type": "object",
      "properties": {
        "equipment_id": { "$ref": "#/$defs/stableId" },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "product_family": { "type": "string", "minLength": 1 },
        "remote_interface_id": { "$ref": "#/$defs/stableId" },
        "remote_interface_role": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["equipment_id"] },
        { "required": ["manufacturer"] },
        { "required": ["model"] },
        { "required": ["product_family"] },
        { "required": ["remote_interface_id"] },
        { "required": ["remote_interface_role"] }
      ],
      "additionalProperties": false
    },
    "connectionConstraints": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "protocol_family": { "type": "string", "minLength": 1, "description": "Must match the canonical protocol_family of the proprietary signal on this interface." },
        "remote_interface_role": { "type": "string", "minLength": 1 },
        "allowed_targets": {
          "type": "object",
          "required": ["exhaustive", "targets"],
          "properties": {
            "exhaustive": { "type": "boolean" },
            "targets": { "type": "array", "items": { "$ref": "#/$defs/targetSelector" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "denied_targets": {
          "type": "object",
          "required": ["targets"],
          "properties": {
            "targets": { "type": "array", "items": { "$ref": "#/$defs/targetSelector" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "description": "An independent local limit owned by the capability. It is not a shared resource pool and is not automatically additive with one.",
      "properties": {
        "rx_channels": { "type": "integer", "minimum": 0 },
        "tx_channels": { "type": "integer", "minimum": 0 },
        "rx_flows": { "type": "integer", "minimum": 0 },
        "tx_flows": { "type": "integer", "minimum": 0 },
        "streams": { "type": "integer", "minimum": 0 },
        "sessions": { "type": "integer", "minimum": 0 },
        "endpoints": { "type": "integer", "minimum": 0 },
        "bandwidth": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "enum": ["bit/s", "kbit/s", "Mbit/s", "Gbit/s"] }
          },
          "additionalProperties": false
        },
        "other_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "value"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "value": { "type": "number", "minimum": 0 },
              "unit": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "interfaceAssignment": {
      "type": "object",
      "required": ["mode", "allowed_interface_ids"],
      "properties": {
        "mode": { "enum": ["fixed", "configurable", "simultaneous", "redundant", "segregated"] },
        "allowed_interface_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed" } } },
          "then": { "properties": { "allowed_interface_ids": { "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "mode": { "enum": ["redundant", "simultaneous"] } } },
          "then": { "properties": { "allowed_interface_ids": { "minItems": 2 } } }
        }
      ],
      "additionalProperties": false
    },
    "communicationCapability": {
      "type": "object",
      "required": ["id", "type", "direction", "interface_assignment"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["network_audio", "network_video", "control", "data", "discovery", "management", "other"] },
        "protocol_family": { "type": "string", "minLength": 1, "description": "Optional technical protocol or protocol family. Its absence means no family was identified or documented, not that communication is absent." },
        "media_type": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output", "bidirectional"] },
        "interface_assignment": { "$ref": "#/$defs/interfaceAssignment" },
        "capacity": { "$ref": "#/$defs/capacity" },
        "resource_pool_id": { "$ref": "#/$defs/stableId" },
        "availability": { "enum": ["available", "conditional", "unavailable"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resourcePool": {
      "type": "object",
      "description": "A limit shared by one or more capabilities. It is not automatically added to capability capacities.",
      "required": ["id", "resources"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string" },
        "resources": { "$ref": "#/$defs/capacity" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capacityOverride": {
      "type": "object",
      "properties": {
        "rx_channels": { "type": "integer", "minimum": 0 },
        "tx_channels": { "type": "integer", "minimum": 0 },
        "rx_flows": { "type": "integer", "minimum": 0 },
        "tx_flows": { "type": "integer", "minimum": 0 },
        "streams": { "type": "integer", "minimum": 0 },
        "sessions": { "type": "integer", "minimum": 0 },
        "endpoints": { "type": "integer", "minimum": 0 },
        "bandwidth": { "$ref": "#/$defs/capacity/properties/bandwidth" },
        "other_limits": { "$ref": "#/$defs/capacity/properties/other_limits" }
      },
      "additionalProperties": false
    },
    "capabilityModifier": {
      "type": "object",
      "required": ["id", "type", "name", "affects"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["license", "installed_module", "firmware_feature", "configuration", "hardware_option"] },
        "name": { "type": "string", "minLength": 1 },
        "source_equipment_id": { "$ref": "#/$defs/stableId" },
        "affects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["target_type", "target_id"],
            "properties": {
              "target_type": { "enum": ["communication_capability", "resource_pool", "capability"] },
              "target_id": { "$ref": "#/$defs/stableId" },
              "capacity_override": { "$ref": "#/$defs/capacityOverride" },
              "availability": { "enum": ["available", "conditional", "unavailable"] },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slotAcceptance": {
      "type": "object",
      "properties": {
        "manufacturers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "product_families": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "models": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "module_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "interface_mechanical": { "type": "string" },
        "other_constraints": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["id", "label", "slot_type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "type": "string", "minLength": 1 },
        "slot_type": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "position": { "type": "object", "additionalProperties": true },
        "accepts": { "$ref": "#/$defs/slotAcceptance" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "modularity": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": { "enum": ["standalone", "chassis", "module", "hybrid"] },
        "module_type": { "type": "string" },
        "compatible_slot_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" }, "uniqueItems": true },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "enum": ["chassis", "hybrid"] } } },
          "then": { "required": ["slots"], "properties": { "slots": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "role": { "const": "module" } } },
          "then": { "required": ["module_type", "compatible_slot_types"] }
        }
      ],
      "additionalProperties": false
    },
    "compositionMetadata": {
      "type": "object",
      "properties": {
        "composable": { "type": "boolean" },
        "capability_derivation": { "enum": ["none", "from_installed_modules", "future"] },
        "interface_addressing_scheme": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "name": { "type": "string", "minLength": 1 },
          "value": {},
          "unit": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      },
      "uniqueItems": true
    },
    "infrastructure": {
      "type": "object",
      "properties": {
        "rack_requirements": { "type": "array", "items": { "type": "string" } },
        "ventilation": { "type": "string" },
        "power_requirements": { "type": "array", "items": { "type": "string" } },
        "network_requirements": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "functionalBehavior": {
      "type": "object",
      "properties": {
        "receives_signals": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "processing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "name": { "type": "string", "minLength": 1 },
              "input_signal_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
              "output_signal_ids": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          },
          "uniqueItems": true
        },
        "produces_signals": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "kind": { "type": "string", "minLength": 1 },
              "target_id": { "$ref": "#/$defs/stableId" },
              "notes": { "type": "string" }
            },
            "additionalProperties": true
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": ["id", "relation"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "relation": { "type": "string", "minLength": 1 },
        "target_equipment_id": { "$ref": "#/$defs/stableId" },
        "target_manufacturer": { "type": "string" },
        "target_model": { "type": "string" },
        "target_product_family": { "type": "string" },
        "local_interface_id": { "$ref": "#/$defs/stableId" },
        "remote_interface_id": { "$ref": "#/$defs/stableId" },
        "remote_interface_role": { "type": "string" },
        "protocol_family": { "type": "string" },
        "validated_by": { "type": "string" },
        "notes": { "type": "string" }
      },
      "anyOf": [
        { "required": ["target_equipment_id"] },
        { "required": ["target_product_family"] },
        { "required": ["target_model"] }
      ],
      "additionalProperties": false
    },
    "graphicRepresentation": {
      "type": "object",
      "properties": {
        "block_name": { "type": "string" },
        "block_file": { "type": "string" },
        "layer": { "type": "string" },
        "connection_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "interface_id"],
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "interface_id": { "$ref": "#/$defs/stableId" },
              "label": { "type": "string" },
              "position": { "type": "object", "additionalProperties": true },
              "metadata": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "documentReference": {
      "type": "object",
      "required": ["type", "uri"],
      "properties": {
        "type": { "enum": ["product_page", "datasheet", "manual", "installation_guide", "other"] },
        "uri": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "language": { "type": "string" },
        "accessed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "internalKnowledge": {
      "type": "object",
      "properties": {
        "recommended_practices": { "type": "array", "items": { "type": "string" } },
        "field_observations": { "type": "array", "items": { "type": "string" } },
        "known_restrictions": { "type": "array", "items": { "type": "string" } },
        "internal_standards": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "source": { "type": "string" },
        "updated_by": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}

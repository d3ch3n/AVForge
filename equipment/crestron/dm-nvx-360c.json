  "communication_capabilities": [
    {
      "id": "dm-nvx-network-video",
      "type": "network_video",
      "protocol_family": "dm-nvx",
      "media_type": "video",
      "direction": "bidirectional",
      "interface_assignment": { "mode": "configurable", "allowed_interface_ids": ["ethernet-1", "ethernet-2", "ethernet-4-sfp"] },
      "notes": "The card is configurable as an encoder or decoder. Ethernet ports 1, 2, or 4 can transport video over a Gigabit Ethernet network."
    },
    {
      "id": "aes67-audio",
      "type": "network_audio",
      "protocol_family": "aes67",
      "media_type": "audio",
      "direction": "bidirectional",
      "interface_assignment": { "mode": "configurable", "allowed_interface_ids": ["ethernet-1", "ethernet-2", "ethernet-3", "ethernet-4-sfp"] },
      "capacity": { "rx_channels": 2, "tx_channels": 2 },
      "notes": "Official Product Manual DOC. 8879D states that Audio/NAX defaults to Port 3 and may be selected on Ethernet ports 1, 2, 3, or 4. The same manual documents 2-channel AES67 transmit/receive behavior for this family."
    },
    {
      "id": "usb-extension",
      "type": "data",
      "protocol_family": "usb-2-0",
      "direction": "bidirectional",
      "interface_assignment": { "mode": "configurable", "allowed_interface_ids": ["usb-device", "usb-host"] },
      "notes": "The official documentation supports USB 2.0 Layer 2 or Layer 3 extension/routing and states that USB device or USB host operation is selected, not both."
    },
    {
      "id": "cec-control",
      "type": "control",
      "protocol_family": "cec",
      "media_type": "control",
      "direction": "bidirectional",
      "interface_assignment": { "mode": "simultaneous", "allowed_interface_ids": ["hdmi-input", "hdmi-output"] },
      "notes": "The official DM-NVX-360C documentation states that the card provides a gateway for controlling source and display devices via CEC over the HDMI connections; CEC over the HDMI output can also control display power without a control system."
    },
    {
      "id": "device-control",
      "type": "control",
      "direction": "bidirectional",
      "interface_assignment": { "mode": "simultaneous", "allowed_interface_ids": ["ethernet-1", "ethernet-2", "ethernet-3", "ethernet-4-sfp"] },
      "notes": "Generic web and control-system management over Ethernet; protocol-specific CEC is modeled separately."
    }
